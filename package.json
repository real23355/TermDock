{
  "name": "termdock",
  "productName": "TermDock",
  "version": "0.0.2-1117",
  "releaseVersion": "V0.0.2_1117",
  "private": true,
  "description": "Windows SSH and serial terminal with reboot testing",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node tests/app.cjs",
    "package:win": "npm run typecheck && node scripts/package-win.mjs",
    "test:portable": "node tests/portable.cjs"
  },
  "dependencies": {
    "serialport": "13.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/ssh2": "1.15.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
